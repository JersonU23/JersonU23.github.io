# ===== FITNESS AI — variables de entorno =====
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

NODE_ENV=development
PORT=3000
# URL pública de la app (se usa para validar el origen de las peticiones)
APP_ORIGIN=http://localhost:3000

# PostgreSQL (Neon, Supabase, Railway, RDS o local)
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_dev
# true si el proveedor exige TLS (la mayoría de servicios gestionados)
DATABASE_SSL=false

# Clave de cifrado de datos de salud: 32 bytes en base64.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, los datos de salud cifrados NO se pueden recuperar. Guárdala en un gestor de secretos.
APP_ENCRYPTION_KEY=

# Proveedor de IA (Anthropic). Sin esta clave, las funciones de IA responden "IA no configurada".
ANTHROPIC_API_KEY=

# Duración de la sesión en horas
SESSION_TTL_HOURS=72
